Model Card HTML =
VAR _Css =
    "<style>
      .mc { position:relative; font-family:'Segoe UI',system-ui,sans-serif; padding:4px 6px 6px; overflow:hidden; animation:mcIn .7s cubic-bezier(.2,.8,.2,1) both; }
      .mc-head { display:flex; align-items:center; gap:10px; margin-bottom:10px; }
      .mc-dot { width:11px; height:11px; border-radius:50%; background:#1BAF7A; box-shadow:0 0 0 0 rgba(27,175,122,.6); animation:mcPulse 2.4s ease-out infinite; flex:none; }
      .mc-title { font-size:19px; font-weight:600; color:#14142B; letter-spacing:-.3px; }
      .mc-bar { height:4px; border-radius:3px; margin-bottom:15px; background:linear-gradient(90deg,#2A78D6,#4A3AA7,#1BAF7A,#2A78D6); background-size:300% 100%; animation:mcSweep 6s linear infinite; }
      .mc-chip { display:inline-block; background:#F4F5FA; border:1px solid #DEDFEC; border-radius:7px; padding:4px 10px; margin:0 6px 7px 0; font-size:13px; color:#14142B; opacity:0; animation:mcIn .5s ease-out forwards; }
      .mc-chip:nth-child(1){animation-delay:.15s} .mc-chip:nth-child(2){animation-delay:.25s}
      .mc-chip:nth-child(3){animation-delay:.35s} .mc-chip:nth-child(4){animation-delay:.45s}
      .mc-note { font-size:13.5px; color:#5A5B73; margin:5px 0 13px; }
      .mc-score { display:inline-flex; align-items:baseline; gap:10px; padding:11px 15px; background:linear-gradient(135deg,#F4F5FA,#FFFFFF); border:1px solid #DEDFEC; border-radius:9px; margin-bottom:15px; }
      .mc-score .v { font-size:30px; font-weight:600; color:#2A78D6; letter-spacing:-.6px; }
      .mc-score .l { font-size:13px; color:#5A5B73; }
      .mc-links { display:flex; gap:10px; position:relative; z-index:2; }
      .mc-links a { display:inline-flex; align-items:center; gap:7px; text-decoration:none; font-size:13.5px; font-weight:600; color:#14142B; background:#FFFFFF; border:1px solid #DEDFEC; border-radius:8px; padding:8px 14px; transition:all .22s ease; }
      .mc-links a:hover { border-color:#2A78D6; color:#2A78D6; transform:translateY(-2px); box-shadow:0 5px 12px rgba(42,120,214,.18); }
      .mc-links svg { width:16px; height:16px; fill:currentColor; }
      .mc-sea { position:absolute; right:-6px; bottom:-4px; width:190px; height:96px; pointer-events:none; z-index:1; }
      .mc-ship { animation:mcBob 4.2s ease-in-out infinite; transform-origin:70px 55px; }
      .mc-wave1 { animation:mcWave 3.4s linear infinite; }
      .mc-wave2 { animation:mcWave 5.2s linear infinite reverse; }
      .mc-puff { animation:mcSmoke 3.2s ease-out infinite; }
      .mc-puff:nth-of-type(2){animation-delay:1s} .mc-puff:nth-of-type(3){animation-delay:2s}
      @keyframes mcIn { from{opacity:0;transform:translateY(9px)} to{opacity:1;transform:none} }
      @keyframes mcSweep { to{background-position:300% 0} }
      @keyframes mcPulse { 0%{box-shadow:0 0 0 0 rgba(27,175,122,.55)} 70%{box-shadow:0 0 0 10px rgba(27,175,122,0)} 100%{box-shadow:0 0 0 0 rgba(27,175,122,0)} }
      @keyframes mcBob { 0%,100%{transform:translateY(0) rotate(-1.2deg)} 50%{transform:translateY(-4px) rotate(1.2deg)} }
      @keyframes mcWave { to{transform:translateX(-40px)} }
      @keyframes mcSmoke { 0%{opacity:0;transform:translate(0,0) scale(.5)} 25%{opacity:.5} 100%{opacity:0;transform:translate(-16px,-26px) scale(1.9)} }
    </style>"
VAR _Head =
    "<div class='mc'>
       <div class='mc-head'>
         <span class='mc-dot'></span>
         <span class='mc-title'>Random Forest Classifier</span>
       </div>
       <div class='mc-bar'></div>"
VAR _Chips =
    "<div>
       <span class='mc-chip'>100 trees</span>
       <span class='mc-chip'>max depth 4</span>
       <span class='mc-chip'>9 features</span>
       <span class='mc-chip'>random_state 1</span>
     </div>
     <div class='mc-note'>Validated with stratified 5-fold cross-validation</div>"
VAR _Score =
    "<div class='mc-score'>
       <span class='v'>0.80861</span>
       <span class='l'>Kaggle public score &middot; unseen test set</span>
     </div>"
VAR _Ship =
    "<svg class='mc-sea' viewBox='0 0 190 96' xmlns='http://www.w3.org/2000/svg'>
       <g class='mc-ship' fill='#C9CBDA'>
         <circle class='mc-puff' cx='62' cy='26' r='4' fill='#DEDFEC'/>
         <circle class='mc-puff' cx='78' cy='26' r='4' fill='#DEDFEC'/>
         <circle class='mc-puff' cx='94' cy='26' r='4' fill='#DEDFEC'/>
         <rect x='58' y='26' width='9' height='19' rx='1.5' transform='skewX(-7)'/>
         <rect x='74' y='26' width='9' height='19' rx='1.5' transform='skewX(-7)'/>
         <rect x='90' y='26' width='9' height='19' rx='1.5' transform='skewX(-7)'/>
         <rect x='106' y='26' width='9' height='19' rx='1.5' transform='skewX(-7)'/>
         <rect x='40' y='39' width='96' height='9' rx='2'/>
         <rect x='32' y='16' width='2' height='30' rx='1'/>
         <rect x='146' y='19' width='2' height='27' rx='1'/>
         <path d='M22 47 L150 47 L168 39 L168 48 L150 60 L34 60 Z'/>
       </g>
       <path class='mc-wave1' d='M-40 64 q10 -5 20 0 t20 0 t20 0 t20 0 t20 0 t20 0 t20 0 t20 0 t20 0 t20 0 t20 0 t20 0' fill='none' stroke='#2A78D6' stroke-width='2.5' stroke-linecap='round' opacity='.5'/>
       <path class='mc-wave2' d='M-40 72 q10 -5 20 0 t20 0 t20 0 t20 0 t20 0 t20 0 t20 0 t20 0 t20 0 t20 0 t20 0 t20 0' fill='none' stroke='#2A78D6' stroke-width='2.5' stroke-linecap='round' opacity='.28'/>
     </svg>"
VAR _Links =
    "<div class='mc-links'>
       <a href='https://github.com/XavieerMurillo' target='_blank' rel='noopener'>
         <svg viewBox='0 0 16 16'><path d='M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z'/></svg>
         GitHub
       </a>
       <a href='https://www.kaggle.com/murilloxavier' target='_blank' rel='noopener'>
         <svg viewBox='0 0 16 16'><path d='M9.6 15.6 5.5 10.4l-1.2 1.2v4H2V0h2.3v8.9l4.1-4.3h2.9L7.1 9.1l4.3 6.5H9.6z'/></svg>
         Kaggle
       </a>
     </div>
   </div>"
RETURN
    _Css & _Head & _Chips & _Score & _Ship & _Links
